version: 1
language: nl
categories:
  email:
    severity: medium
    rules:
      - id: email.basic
        pattern: (?i)\b[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}\b
        explanation: Bevat een e-mailadres.

  ip:
    severity: medium
    rules:
      - id: ip.v4
        pattern: \b(?:(?:25[0-5]|2[0-4]\d|[01]?\d?\d)\.){3}(?:25[0-5]|2[0-4]\d|[01]?\d?\d)\b
        explanation: Bevat een IPv4-adres.

